  "components": {
    "schemas": {
      "products_update_body": {
        "type": "object",
        "properties": {
          "imageFile": {
            "type": "string",
            "format": "binary"
          },
          "name": {
            "type": "string",
            "example": "Traditional Panbag"
          },
          "sku": {
            "type": "integer",
            "example": 1234567823431055
          },
          "price": {
            "type": "integer",
            "example": 25
          },
          "stockQuantity": {
            "type": "integer",
            "example": 21
          },
          "categoryId": {
            "type": "integer",
            "example": 3
          },
          "description": {
            "type": "string",
            "example": "SriLankan traditional bag"
          },
          "productId": {
            "type": "integer",
            "example": 6
          }
        }
      },
      "products_add_body": {
        "type": "object",
        "properties": {
          "imageFile": {
            "type": "string",
            "format": "binary"
          },
          "name": {
            "type": "string",
            "example": "cloth size 20"
          },
          "sku": {
            "type": "integer",
            "example": 123456789101112
          },
          "price": {
            "type": "integer",
            "example": 10
          },
          "stockQuantity": {
            "type": "integer",
            "example": 2
          },
          "categoryId": {
            "type": "integer",
            "example": 5
          },
          "description": {
            "type": "string",
            "example": "Kids Collection"
          }
        }
      }
    },
